# Copia este archivo a .env (ignorado por Git) para probar docker-compose.prod.yml en local
# En producción (Render / Azure Container Apps), configura estas variables en el panel del proveedor.

APP_PORT=8080
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave-en-local
POSTGRES_DB=PergamonLensDb

# Claves opcionales para IA multimodal (Google AI Studio) y catálogo musical (Discogs)
VISION_API_KEY=
DISCOGS_TOKEN=
